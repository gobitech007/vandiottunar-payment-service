# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
# Its own database on the same PostgreSQL server (create "vandi_payments" once in pgAdmin)
DATABASE_URL=postgresql+asyncpg://postgres:admin@localhost:5432/vandi_payments

# MUST be the same JWT_SECRET as the user-service and order-service
JWT_SECRET=change-me
# The order-service and the shared SERVICE_TOKEN (same value in every service's .env)
ORDER_SERVICE_URL=http://localhost:8001
SERVICE_TOKEN=dev-service-token-change-me-0123456789abcdef

# mock = test checkout page on this service (no money, no keys); razorpay = real payments
PAYMENT_PROVIDER=mock
# Razorpay Dashboard -> Account & Settings -> API Keys (use rzp_test_ keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard -> Webhooks: URL https://<PUBLIC_URL>/payments/webhooks/razorpay, event payment_link.paid
RAZORPAY_WEBHOOK_SECRET=

# Address of this service as browsers see it (Razorpay sends customers back here after paying)
PUBLIC_URL=http://localhost:8002
# After paying, customers return to their booking: website dashboard or the Android app
WEB_URL=http://localhost:5173
APP_RETURN_URL=vandiottunar://payment

CORS_ORIGINS=http://localhost:5173,http://localhost:8081
